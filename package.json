{
  "name": "mytasks",
  "version": "1.9.3",
  "private": true,
  "description": "My Tasks - A free and open source task manager",
  "type": "module",
  "license": "MIT",
  "author": "Michael Lines",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberAdvisor/mytasks.git"
  },
  "homepage": "https://mytasks.fyi",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node scripts/serve.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "perf": "playwright test -c perf/perf.config.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts e2e/screenshots.shoot.ts",
    "screenshots:book": "playwright test -c playwright.screenshots.config.ts e2e/book.shoot.ts",
    "book:pdf": "node scripts/book-pdf.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "fractional-indexing": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@vite-pwa/assets-generator": "^2.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "pdf-lib": "^1.17.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
